# ==============================================================================
# LEARNING POINT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Never commit real credentials or private keys to source control.
# ==============================================================================

# Application URL & General
VITE_APP_URL="http://localhost:3000"
VITE_APP_NAME="Learning Point"

# Supabase Public & Anon Key
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Privileged Key (Server / Workers only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Turso (libSQL Edge DB for Attempts, Question Bank, AI Queue)
VITE_TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# Razorpay Test / Live Configuration
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# AI Provider API Keys (Server only)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Backup & Storage Integrations
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
BACKUP_ENCRYPTION_KEY=""

# Turnstile Anti-Abuse (Optional)
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
